---
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';

const pad = (n: number) => String(n).padStart(2, '0');
const listUrl = site.playlistId ? `https://music.163.com/#/playlist?id=${site.playlistId}` : '';
---

<Base title="音乐" desc="最近在循环的东西。曲目会换，理由不会。">
  <div class="page" data-pagefind-ignore>
    <div class="wrap">
      <div class="page-head">
        <h1><span class="kicker">SOUND</span>音乐</h1>
        <p>最近在循环的东西。声音走网易云音乐的接口，点一下就能听。</p>
      </div>

      <section class="stage" data-deck>
        <span class="stage-art" aria-hidden="true">
          <span class="disc">
            <span class="disc-face">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M15 5v9.2a3.2 3.2 0 1 1-3.2-3.2"></path>
                <path d="M15 5c.5 2.2 2 3.5 3.6 3.8"></path>
              </svg>
            </span>
          </span>
        </span>

        <div class="stage-main">
          <p class="stage-kick">
            正在听 · <b data-deck="count">01</b> / <span data-deck="total">--</span>
          </p>
          <h2 class="stage-name" data-deck="name">加载中...</h2>
          <p class="stage-artist" data-deck="artist"></p>
          <p class="stage-why" data-deck="why"></p>

          <div class="stage-time">
            <span data-deck="cur">0:00</span>
            <button class="stage-bar" type="button" data-deck="bar" aria-label="播放进度，点一下跳过去">
              <i data-deck="fill"></i>
            </button>
            <span data-deck="dur">0:00</span>
            <span class="stage-clip" data-deck="clip" hidden title="公共接口没登录态，这首只放得出试听">
              试听
            </span>
          </div>

          <div class="stage-actions">
            <button class="stage-step" type="button" data-deck="prev" aria-label="上一首">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                <path d="M7 6v12M18 6l-8 6 8 6z"></path>
              </svg>
            </button>
            <button
              class="stage-big"
              type="button"
              data-deck="toggle"
              aria-label="播放"
              aria-pressed="false"
            >
              <svg class="i-play" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                <path d="M8 6l9 6-9 6z"></path>
              </svg>
              <svg class="i-pause" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                <path d="M9 6v12M15 6v12"></path>
              </svg>
            </button>
            <button class="stage-step" type="button" data-deck="next" aria-label="下一首">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                <path d="M17 6v12M6 6l8 6-8 6z"></path>
              </svg>
            </button>
            <a
              class="stage-out"
              href="#"
              target="_blank"
              rel="noopener"
              data-deck="song"
            >
              网易云音乐 ↗
            </a>
          </div>
        </div>
      </section>

      <div class="mpanel is-on" data-panel="list">
        <ul class="tracks" data-deck="list">
          <li><p class="lyr-wait">正在加载歌单...</p></li>
        </ul>
        <p class="mpanel-note">
          点一条就换上面那张卡，直接开播。
          {
            listUrl && (
              <>
                <br />
                <a href={listUrl} target="_blank" rel="noopener">
                  在网易云音乐打开歌单 ↗
                </a>
              </>
            )
          }
        </p>
      </div>
    </div>
  </div>

  <script type="application/json" id="deck-tracks" set:html={JSON.stringify({ api: site.musicApi, playlistId: site.playlistId })} />
  <script>
    function bindMusicDeck() {
      const { createDeck } = NepentheSound;

      const root = document.querySelector('[data-deck]');
      const data = document.getElementById('deck-tracks');
      if (root && data) {
      const { api, playlistId } = JSON.parse(data.textContent);
      const pick = (key) => document.querySelector(`[data-deck="${key}"]`);

      // 从歌单接口动态拉取歌曲列表（固定网易云源）
      const playlistUrl = `${api}${api.includes('?') ? '&' : '?'}type=playlist&id=${playlistId}`;
      fetch(playlistUrl)
        .then((r) => r.json())
        .then((playlist) => {
          // 把 Meting 返回的格式转换成播放器需要的格式
          const tracks = playlist.map((song, i) => {
            const idMatch = song.url && song.url.match(/id=([^&]+)/);
            return {
              id: idMatch ? idMatch[1] : `song-${i}`,
              name: song.name || '未知歌曲',
              artist: song.artist || '未知艺术家',
              dur: 300,
              why: '网易云歌单',
            };
          });
          if (!tracks.length) throw new Error('歌单为空');
          return tracks;
        })
        .then((tracks) => {
          const deck = createDeck(tracks, api);

          // 更新总数
          pick('total').textContent = String(tracks.length).padStart(2, '0');

          // 渲染曲目列表
          const listEl = pick('list');
          listEl.innerHTML = '';
          tracks.forEach((t, i) => {
            const li = document.createElement('li');
            const btn = document.createElement('button');
            btn.className = `track${i === 0 ? ' is-on' : ''}`;
            btn.type = 'button';
            btn.dataset.i = String(i);
            btn.innerHTML = `
              <span class="no">${String(i + 1).padStart(2, '0')}</span>
              <span class="nm">
                ${t.name}
                <small>${t.artist}</small>
              </span>
              <span class="why">${t.why}</span>
            `;
            btn.addEventListener('click', () => deck.pick(i));
            li.appendChild(btn);
            listEl.appendChild(li);
          });

          deck.on('track', ({ index, track }) => {
            pick('count').textContent = String(index + 1).padStart(2, '0');
            pick('name').textContent = track.name;
            pick('artist').textContent = track.artist;
            pick('why').textContent = track.why;
            pick('song').href = `https://music.163.com/#/song?id=${track.id}`;
            pick('cur').textContent = '0:00';
            pick('dur').textContent = '0:00';
            pick('fill').style.width = '0%';
            pick('clip').hidden = true;
            document.querySelectorAll('.track[data-i]').forEach((el) => {
              const on = Number(el.dataset.i) === index;
              el.classList.toggle('is-on', on);
              el.setAttribute('aria-current', on ? 'true' : 'false');
            });
          });

          deck.on('state', (state) => {
            const playing = state === 'playing';
            root.classList.toggle('is-playing', playing);
            root.classList.toggle('is-loading', state === 'loading');
            const btn = pick('toggle');
            btn.setAttribute('aria-pressed', String(playing));
            btn.setAttribute('aria-label', playing ? '暂停' : '播放');
            if (state === 'error') pick('why').textContent = '这首的音频没拿到，点右上角链接去网易云听';
          });

          deck.on('time', ({ cur, dur, ratio, short }) => {
            pick('cur').textContent = deck.fmt(cur);
            pick('dur').textContent = deck.fmt(dur);
            pick('fill').style.width = `${ratio * 100}%`;
            pick('clip').hidden = !short;
          });

          pick('prev').addEventListener('click', () => deck.prev());
          pick('next').addEventListener('click', () => deck.next());
          pick('toggle').addEventListener('click', () => deck.toggle());
          pick('bar').addEventListener('click', (event) => {
            const rect = event.currentTarget.getBoundingClientRect();
            deck.seek((event.clientX - rect.left) / rect.width);
          });

          deck.init();
        })
        .catch((err) => {
          pick('name').textContent = '加载失败';
          pick('artist').textContent = '网易云歌单加载出错了';
          pick('why').textContent = String(err);
        });
      }
    }
    document.addEventListener('astro:page-load', bindMusicDeck);
  </script>
</Base>
