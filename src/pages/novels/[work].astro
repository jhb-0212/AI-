---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { link } from '../../utils/url';

export async function getStaticPaths() {
  const works = await getCollection('novels', ({ data }) => !data.draft);
  return works.map((work) => ({ params: { work: work.id }, props: { work } }));
}

const { work } = Astro.props;

const chapters = (await getCollection('chapters', ({ data }) => !data.draft))
  .filter((c) => c.id.split('/')[0] === work.id)
  .sort((a, b) => a.data.order - b.data.order);

const pad = (n) => String(n).padStart(2, '0');
const fmt = (d) => `${d.getFullYear()}.${pad(d.getMonth() + 1)}.${pad(d.getDate())}`;
const first = chapters[0];
---

<Base title={work.data.title} desc={work.data.summary}>
  <div class="page" data-pagefind-ignore>
    <div class="wrap">
      <a class="back" href={link('/novels/')}>
        <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M19 12H6M11 6l-6 6 6 6"></path>
        </svg>
        回到小说
      </a>

      <div class="work-head">
        <span class="novel-status">{work.data.status}</span>
        <h1>{work.data.title}</h1>
        {work.data.subtitle ? <div class="work-sub">{work.data.subtitle}</div> : null}
        <p class="work-sum">{work.data.summary}</p>
        <div class="work-meta">
          <span>{chapters.length} 章</span>
          <span>最近更新 {fmt(work.data.updated)}</span>
          {work.data.tags.map((t) => <span class="tag">{t}</span>)}
        </div>
        {
          first ? (
            <div class="hero-act">
              <a class="btn btn-primary" href={link(`/novels/${work.id}/${first.id.split('/')[1]}/`)}>
                从第一章读起
              </a>
            </div>
          ) : null
        }
      </div>

      <ol class="chap-list">
        {
          chapters.map((c, i) => (
            <li>
              <a class="chap-row" href={link(`/novels/${work.id}/${c.id.split('/')[1]}/`)}>
                <span class="chap-no">{String(i + 1).padStart(2, '0')}</span>
                <span class="chap-title">{c.data.title}</span>
                <span class="chap-date">{fmt(c.data.date)}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="wrap work-body">
      <slot />
    </div>
  </div>
</Base>
